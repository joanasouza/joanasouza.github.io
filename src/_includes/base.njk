<!DOCTYPE html>
<html lang="{{ lang or 'en' }}" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="{{ description or site.description }}">
  <title>{% if title %}{{ title }} | {% endif %}xuanaonline</title>

  <link rel="icon" type="image/svg+xml" href="/assets/images/favicon.svg">
  <link rel="alternate" type="application/rss+xml" title="xuanaonline RSS Feed" href="/feed.xml">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://use.typekit.net/trv0bzn.css">
  <link rel="stylesheet" href="https://use.typekit.net/trv0bzn.css">
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,700;1,9..40,400&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
  <link href="https://api.fontshare.com/v2/css?f[]=neulis-cursive@400,700&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/assets/css/main.css">

  <script>
    (function () {
      var saved = localStorage.getItem('theme');
      var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.setAttribute('data-theme', saved || (prefersDark ? 'dark' : 'light'));
    })();
  </script>

  <meta property="og:title" content="{% if title %}{{ title }} | {% endif %}xuanaonline">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:type" content="{% if layout == 'post.njk' %}article{% else %}website{% endif %}">
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to main content</a>

  <header class="site-header" role="banner">
    <div class="container">
      <div class="site-header__inner">
        <a href="{% if lang == 'pt' %}/pt/{% else %}/{% endif %}" class="site-logo" aria-label="xuanaonline — home">
          <img src="/assets/images/favicon.svg" alt="" aria-hidden="true" width="28" height="28">
          xuanaonline
        </a>

        <nav role="navigation" aria-label="Main navigation">
          <ul class="nav-menu" id="nav-menu" role="list">
            {% set t = i18n[lang or 'en'] %}
            <li><a href="{% if lang == 'pt' %}/pt/{% else %}/{% endif %}">{{ t.nav.home }}</a></li>
            <li><a href="{% if lang == 'pt' %}/pt/sobre/{% else %}/about/{% endif %}">{{ t.nav.about }}</a></li>
            <li><a href="{% if lang == 'pt' %}/pt/blog/{% else %}/blog/{% endif %}">{{ t.nav.blog }}</a></li>
          </ul>
        </nav>

        <div class="nav-actions">
          <a href="{{ alternateUrl or ('/pt/' if lang != 'pt' else '/') }}"
             class="btn-icon lang-toggle"
             aria-label="{{ t.lang.switchTo }}">
            {{ 'EN' if lang == 'pt' else 'PT' }}
          </a>

          <button class="btn-icon" id="theme-toggle" aria-label="{{ t.theme.toDark }}">
            <span class="theme-icon" aria-hidden="true">🌙</span>
          </button>

          <button class="nav-toggle" id="nav-toggle"
                  aria-expanded="false"
                  aria-controls="nav-menu"
                  aria-label="Menu">
            <span class="nav-toggle__bar"></span>
            <span class="nav-toggle__bar"></span>
            <span class="nav-toggle__bar"></span>
          </button>
        </div>
      </div>
    </div>
  </header>

  <main id="main-content">
    {{ content | safe }}
  </main>

  <footer class="site-footer" role="contentinfo">
    <div class="container">
      <p class="footer-text">
        {{ t.footer.made }} <span class="footer-heart" aria-label="love">♥</span> {{ t.footer.and }}
      </p>
      <ul class="footer-links" role="list">
        <li><a href="/feed.xml">RSS</a></li>
        <li><a href="{{ site.instagram }}" target="_blank" rel="noopener noreferrer">Instagram</a></li>
        <li><a href="{{ site.linkedin }}" target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
      </ul>
    </div>
  </footer>

  <script src="/assets/js/main.js"></script>
</body>
</html>
