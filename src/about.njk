---
layout: base.njk
lang: en
title: About
alternateUrl: /pt/sobre/
description: About Joana Santos — front-end developer and future designer based in Brazil
permalink: /about/
---
{% set t = i18n['en'] %}

<div class="about-section">
  <div class="container">
    <div class="about-content">

      <aside class="about-sidebar" aria-label="Profile">
        <div class="about-avatar">
          <img src="/assets/images/favicon.svg" alt="Joana Santos illustration" width="88" height="88">
        </div>
        <h1 class="about-name">Joana Santos</h1>
        <p class="about-role">Front-end Developer<br>Future Designer</p>

        <div class="hero__social" style="margin-top: var(--space-lg);">
          <a href="{{ site.instagram }}"
             target="_blank"
             rel="noopener noreferrer"
             class="social-link"
             aria-label="Instagram (@xuanaonline)">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                 fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
            </svg>
          </a>
          <a href="{{ site.linkedin }}"
             target="_blank"
             rel="noopener noreferrer"
             class="social-link"
             aria-label="LinkedIn (joana-souza)">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                 fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
              <rect x="2" y="9" width="4" height="12"/>
              <circle cx="4" cy="4" r="2"/>
            </svg>
          </a>
        </div>
      </aside>

      <main aria-label="About content">
        <div class="about-bio">
          <p>{{ t.about.bio1 }}</p>
          <p>{{ t.about.bio2 }}</p>
          <p>{{ t.about.bio3 }}</p>
        </div>

        <div class="about-interests">
          <h3>{{ t.about.interests }}</h3>
          <ul class="interests-list" role="list">
            {% for interest in t.about.interestsList %}
            <li>{{ interest }}</li>
            {% endfor %}
          </ul>
        </div>
      </main>

    </div>
  </div>
</div>
